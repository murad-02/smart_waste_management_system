/* ===== SMART WASTE MANAGEMENT SYSTEM — DESIGN SYSTEM ===== */
/* Light theme with deep-indigo sidebar.
   Sidebar BG: #1E1B4B  | Sidebar Active: #7C3AED  | Sidebar Hover: rgba(255,255,255,0.08)
   Main BG: #F8FAFC     | Card BG: #FFFFFF        | Border: #E5E7EB
   Text: #0F172A        | Secondary: #475569      | Muted: #94A3B8
   Primary Accent: #7C3AED */

/* === Global === */
QMainWindow, QWidget {
    background-color: #F8FAFC;
    color: #0F172A;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 12pt;
}

QDialog {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

/* === Labels === */
QLabel {
    color: #0F172A;
    background: transparent;
}

QLabel[class="secondary"] {
    color: #64748B;
    font-size: 10pt;
}

/* === Buttons === */
QPushButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 11pt;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #F1F5F9;
    border-color: #7C3AED;
}

QPushButton:pressed {
    background-color: #EDE9FE;
    color: #7C3AED;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E5E7EB;
}

QPushButton[class="accent"] {
    background-color: #7C3AED;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
    border-radius: 8px;
}

QPushButton[class="accent"]:hover {
    background-color: #8B5CF6;
}

QPushButton[class="accent"]:pressed {
    background-color: #6D28D9;
}

QPushButton[class="danger"] {
    background-color: #EF4444;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-weight: bold;
}

QPushButton[class="danger"]:hover {
    background-color: #F87171;
}

QPushButton[class="danger"]:pressed {
    background-color: #DC2626;
    color: #FFFFFF;
}

QPushButton[class="outline"] {
    background-color: transparent;
    color: #7C3AED;
    border: 2px solid #7C3AED;
    border-radius: 8px;
    font-weight: bold;
}

QPushButton[class="outline"]:hover {
    background-color: #EDE9FE;
    color: #6D28D9;
}

/* === Input Fields === */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 11pt;
    selection-background-color: #7C3AED;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #7C3AED;
}

QLineEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

/* === ComboBox === */
QComboBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 24px;
    font-size: 11pt;
}

QComboBox:hover {
    border-color: #7C3AED;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #64748B;
    margin-right: 10px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    selection-background-color: #7C3AED;
    selection-color: #FFFFFF;
    outline: none;
    border-radius: 8px;
}

/* === SpinBox / DoubleSpinBox === */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 11pt;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #7C3AED;
}

/* === DateEdit === */
QDateEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 11pt;
}

QDateEdit:focus {
    border-color: #7C3AED;
}

QDateEdit::drop-down {
    border: none;
    width: 30px;
}

QCalendarWidget {
    background-color: #FFFFFF;
    color: #0F172A;
}

QCalendarWidget QToolButton {
    color: #0F172A;
    background-color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #F1F5F9;
}

/* === Table Widget === */
QTableWidget {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    selection-background-color: #EDE9FE;
    selection-color: #0F172A;
    alternate-background-color: #F8FAFC;
    font-size: 10pt;
}

QTableWidget::item {
    padding: 8px;
}

QTableWidget::item:hover {
    background-color: #F5F3FF;
}

QTableWidget::item:selected {
    background-color: #EDE9FE;
    color: #0F172A;
}

/* Cell widget containers inside tables must be transparent */
QTableWidget QWidget {
    background-color: transparent;
}

/* Action buttons inside table cells */
QTableWidget QPushButton {
    background-color: #F1F5F9;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 9pt;
    font-weight: bold;
    min-height: 16px;
}

QTableWidget QPushButton:hover {
    background-color: #7C3AED;
    border-color: #7C3AED;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 10px;
    font-weight: bold;
    font-size: 10pt;
}

QHeaderView::section:hover {
    background-color: #F1F5F9;
}

/* === Tab Widget === */
QTabWidget::pane {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    border: 1px solid #E5E7EB;
    border-bottom: none;
    padding: 10px 24px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-size: 11pt;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #7C3AED;
    border-bottom: 3px solid #7C3AED;
}

QTabBar::tab:hover {
    color: #0F172A;
    background-color: #FFFFFF;
}

/* === ScrollBar === */
QScrollBar:vertical {
    background-color: #F8FAFC;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7C3AED;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F8FAFC;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7C3AED;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === GroupBox === */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    margin-top: 12px;
    padding: 20px 16px 16px 16px;
    font-weight: bold;
    font-size: 12pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 14px;
    color: #7C3AED;
}

/* === ProgressBar === */
QProgressBar {
    background-color: #F1F5F9;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    text-align: center;
    color: #0F172A;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #7C3AED;
    border-radius: 7px;
}

/* === CheckBox === */
QCheckBox {
    color: #0F172A;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #7C3AED;
    border-color: #7C3AED;
}

/* === ToolTip === */
QToolTip {
    background-color: #0F172A;
    color: #FFFFFF;
    border: 1px solid #0F172A;
    padding: 8px;
    border-radius: 8px;
    font-size: 10pt;
}

/* ===== CUSTOM CLASSES ===== */

/* Sidebar */
QWidget#sidebar {
    background-color: #1E1B4B;
    border-right: 1px solid #1E1B4B;
}

QWidget#sidebar QLabel {
    color: #E5E7EB;
    background: transparent;
}

QPushButton[class="sidebar-btn"] {
    background-color: transparent;
    color: #C7C9E6;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 12px 16px;
    font-size: 11pt;
    margin: 2px 10px;
}

QPushButton[class="sidebar-btn"]:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}

QPushButton[class="sidebar-btn-active"] {
    background-color: #7C3AED;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 12px 16px;
    font-size: 11pt;
    font-weight: bold;
    margin: 2px 10px;
}

QPushButton[class="sidebar-btn-active"]:hover {
    background-color: #8B5CF6;
}

/* Stat Cards */
QFrame[class="stat-card"] {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    padding: 16px;
}

QFrame[class="stat-card"]:hover {
    background-color: #FAFAFF;
    border-color: #7C3AED;
}

QFrame[class="stat-card-alert"] {
    background-color: #FFFFFF;
    border: 2px solid #EF4444;
    border-radius: 12px;
    padding: 16px;
}

QFrame[class="stat-card-alert"]:hover {
    background-color: #FEF2F2;
    border-color: #F87171;
}

/* Toast Notifications */
QFrame[class="toast-success"] {
    background-color: #10B981;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 14px 22px;
}

QFrame[class="toast-error"] {
    background-color: #EF4444;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 14px 22px;
    font-weight: bold;
}

QFrame[class="toast-warning"] {
    background-color: #F59E0B;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 14px 22px;
    font-weight: bold;
}

QFrame[class="toast-info"] {
    background-color: #3B82F6;
    color: #FFFFFF;
    border-radius: 10px;
    padding: 14px 22px;
    font-weight: bold;
}

/* Severity Badges */
QLabel[class="severity-info"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[class="severity-warning"] {
    background-color: #FEF3C7;
    color: #B45309;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[class="severity-critical"] {
    background-color: #FEE2E2;
    color: #B91C1C;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 9pt;
    font-weight: bold;
}

/* Status Badges */
QLabel[class="status-active"], QLabel[class="status-verified"] {
    background-color: #D1FAE5;
    color: #047857;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[class="status-inactive"], QLabel[class="status-rejected"] {
    background-color: #FEE2E2;
    color: #B91C1C;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[class="status-pending"] {
    background-color: #FEF3C7;
    color: #B45309;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 9pt;
    font-weight: bold;
}

/* Role Badges */
QLabel[class="role-admin"] {
    background-color: #D1FAE5;
    color: #047857;
    border-radius: 10px;
    padding: 3px 12px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[class="role-supervisor"] {
    background-color: #DBEAFE;
    color: #1D4ED8;
    border-radius: 10px;
    padding: 3px 12px;
    font-size: 9pt;
    font-weight: bold;
}

QLabel[class="role-operator"] {
    background-color: #F1F5F9;
    color: #475569;
    border-radius: 10px;
    padding: 3px 12px;
    font-size: 9pt;
    font-weight: bold;
}

/* Content area */
QWidget#content-area {
    background-color: #F8FAFC;
}

/* Login screen */
QWidget#login-card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
}

/* Screen titles */
QLabel[class="screen-title"] {
    font-size: 20pt;
    font-weight: bold;
    color: #0F172A;
}

QLabel[class="screen-subtitle"] {
    font-size: 12pt;
    color: #64748B;
}

/* Section headers */
QLabel[class="section-header"] {
    font-size: 14pt;
    font-weight: bold;
    color: #7C3AED;
    padding-bottom: 4px;
    border-bottom: 2px solid #7C3AED;
}

/* Chart frames */
QFrame[class="chart-frame"] {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

/* Filter bar frames */
QFrame[class="filter-bar"] {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

/* Menu / Popup */
QMenu {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #EDE9FE;
    color: #7C3AED;
}

/* Message Box */
QMessageBox {
    background-color: #FFFFFF;
    color: #0F172A;
}

QMessageBox QPushButton {
    min-width: 80px;
}
